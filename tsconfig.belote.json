{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "belote/src/**/*.ts",
    "belote/src/**/*.svelte",
    "belote/template/**/*.ts",
    "belote/template/**/*.svelte"
  ]
}
